[
  { "title": "Project performance", "tex": "\\text{Performance} = f(\\text{Scope},\\ \\text{Cost},\\ \\text{Time})" },
  { "title": "Pay-back period (uniform return)", "tex": "\\text{Pay-back} = \\frac{\\text{Investment}}{\\text{Annual net return}}" },
  { "title": "Return on investment", "tex": "ROI = \\frac{\\text{Average annual net return}}{\\text{Investment}} \\times 100\\%" },
  { "title": "Present value", "tex": "PV = \\frac{C_n}{(1+d)^n}", "note": "$d$ = discount rate, $n$ = year" },
  { "title": "Net present value", "tex": "NPV = B - C = \\sum_n \\frac{B_n - C_n}{(1+d)^n}", "note": "Accept if $NPV > 0$" },
  { "title": "Benefit–cost ratio (profitability index)", "tex": "BCR = PI = \\frac{B}{C}", "note": "Accept if $B/C > 1$" },
  { "title": "IRR by interpolation", "tex": "IRR \\approx d_1 + \\frac{NPV_1}{NPV_1 - NPV_2}(d_2 - d_1)", "note": "$NPV_1 > 0$ at $d_1$, $NPV_2 < 0$ at $d_2$" },
  { "title": "PERT expected time", "tex": "T_E = \\frac{T_O + 4T_M + T_P}{6}" },
  { "title": "Forward pass (earliest event time)", "tex": "E_j = \\max_i\\,(E_i + t_{ij}), \\quad E_1 = 0" },
  { "title": "Backward pass (latest event time)", "tex": "L_i = \\min_j\\,(L_j - t_{ij}), \\quad L_{end} = E_{end}" },
  { "title": "Event slack", "tex": "S = L - E" },
  { "title": "Total float", "tex": "TF = L_j - E_i - t_{ij}" },
  { "title": "Free float", "tex": "FF = E_j - E_i - t_{ij}" },
  { "title": "Independent float", "tex": "IF = E_j - L_i - t_{ij}", "note": "Take as 0 if negative; $TF \\ge FF \\ge IF$" },
  { "title": "Crash cost slope", "tex": "\\text{Cost slope} = \\frac{C_c - C_n}{T_n - T_c}" },
  { "title": "CPIF fee and price", "tex": "\\text{Fee} = F_t + s\\,(C_t - C_a), \\qquad \\text{Price} = C_a + \\text{Fee}", "note": "$s$ = contractor share; fee limited to min/max" }
]
